views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Learn/10-Raw/test")
    groupBy:
      property: transcript_status
      direction: ASC
    order:
      - file.name
      - channel
      - title
      - chapters_usable
      - transcript_status
      - chapters
      - transcript_source
    sort:
      - property: transcript_source
        direction: ASC
      - property: auto_track_languages
        direction: DESC
      - property: channel
        direction: ASC
    columnSize:
      note.channel: 198
      note.chapters_usable: 88
      note.transcript_status: 75
      note.chapters: 69
      note.transcript_source: 124
